   "command": "ftx",
   "sdk":     "org.kde.Sdk",
   "runtime": "org.kde.Platform",
   "runtime-version": "6.11",
   "finish-args": [
      "--filesystem=host",
      "--device=dri",
      "--socket=wayland",
      "--socket=fallback-x11"
